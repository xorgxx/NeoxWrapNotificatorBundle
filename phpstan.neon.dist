parameters:
  level: 7
  paths:
    - src
    - tests
  # checkMissingIterableValueType / checkGenericClassInNonGenericObjectType /
  # checkMissingCallableSignature are always-on in PHPStan 2.x (params removed).
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - '#final classes cannot be doubled#'
    -
      message: '#Call to an undefined method\s+Symfony\\\\Component\\\\Config\\\\Definition\\\\Builder\\\\NodeParentInterface::booleanNode#'
      paths:
        - src/DependencyInjection/Configuration.php
